# Postgres. Local dev uses the `db` service from docker-compose (port 5434).
# Inside docker-compose the app overrides this to point at the `db` host.
POSTGRES_PASSWORD=dih
DATABASE_URL=postgres://dih:dih@localhost:5434/dih

# Random string, e.g. `openssl rand -hex 32`. Never change it in production:
# it signs admin sessions.
PAYLOAD_SECRET=change-me

# Public site URL (used for absolute links in the admin and og:image).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# S3-compatible storage for uploads (Cloudflare R2). If any of these is empty,
# uploads are stored on disk in ./media instead.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=dih
